{
  "name": "@jorisjonkers-dev/agents-ui",
  "type": "module",
  "version": "0.19.1",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "license": "LicenseRef-JorisJonkers-Proprietary-1.0",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "cap:sync": "cap sync",
    "cap:add:android": "cap add android",
    "cap:add:ios": "cap add ios",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs --output-type err",
    "stryker": "stryker run",
    "verify": "pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm depcruise && pnpm build"
  },
  "dependencies": {
    "@capacitor/android": "7.6.9",
    "@capacitor/app": "7.1.2",
    "@capacitor/core": "7.6.9",
    "@capacitor/ios": "7.6.9",
    "@capacitor/preferences": "7.0.4",
    "@capacitor/splash-screen": "7.0.5",
    "@capacitor/status-bar": "7.0.6",
    "@grafana/faro-web-sdk": "2.12.0",
    "@grafana/faro-web-tracing": "2.12.0",
    "@jorisjonkers-dev/agents-api-client": "0.19.2",
    "@jorisjonkers-dev/auth-api-client": "0.9.0",
    "@jorisjonkers-dev/vue-web-commons": "0.4.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "pinia": "3.0.4",
    "primevue": "4.5.5",
    "vue": "3.5.43",
    "vue-router": "5.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@antfu/eslint-config": "9.5.1",
    "@capacitor/cli": "7.6.9",
    "@playwright/test": "1.63.0",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-vue": "6.0.9",
    "@vitest/coverage-v8": "4.1.11",
    "@vue/test-utils": "2.5.1",
    "dependency-cruiser": "17.4.3",
    "eslint": "10.11.0",
    "jsdom": "29.1.1",
    "msw": "2.15.0",
    "prettier": "3.9.8",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vitest": "4.1.11",
    "vue-tsc": "3.3.11"
  }
}
